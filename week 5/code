#include <stdio.h>
#include <stdlib.h>

struct node
{
    int data;
    struct node *prev;
    struct node *next;
};

struct node *start = NULL;


struct node *create_ll(struct node *start)
{
    struct node *newnode, *ptr;
    int num, n, i;

    printf("\nEnter how many values you want to insert: ");
    scanf("%d", &n);

    start = NULL;

    for (i = 0; i < n; i++)
    {
        newnode = (struct node *)malloc(sizeof(struct node));

        printf("Enter value %d: ", i + 1);
        scanf("%d", &num);

        newnode->data = num;
        newnode->prev = NULL;
        newnode->next = NULL;

        if (start == NULL)
            start = newnode;
        else
        {
            ptr = start;
            while (ptr->next != NULL)
                ptr = ptr->next;

            ptr->next = newnode;
            newnode->prev = ptr;
        }
    }
    return start;
}


struct node *insert_before(struct node *start)
{
    struct node *ptr, *newnode;
    int num, val;

    if (start == NULL)
    {
        printf("List is empty!\n");
        return start;
    }

    printf("\nEnter the data to insert: ");
    scanf("%d", &num);

    printf("Enter the value before which to insert: ");
    scanf("%d", &val);

    newnode = (struct node *)malloc(sizeof(struct node));
    newnode->data = num;
    newnode->prev = NULL;
    newnode->next = NULL;

    ptr = start;
    while (ptr != NULL && ptr->data != val)
        ptr = ptr->next;

    if (ptr == NULL)
    {
        printf("Value not found!\n");
        free(newnode);
        return start;
    }

    newnode->next = ptr;
    newnode->prev = ptr->prev;

    if (ptr->prev != NULL)
        ptr->prev->next = newnode;
    else
        start = newnode;

    ptr->prev = newnode;

    return start;
}


struct node *delete_value(struct node *start)
{
    struct node *ptr;
    int val;

    if (start == NULL)
    {
        printf("List is empty!\n");
        return start;
    }

    printf("\nEnter value to delete: ");
    scanf("%d", &val);

    ptr = start;
    while (ptr != NULL && ptr->data != val)
        ptr = ptr->next;

    if (ptr == NULL)
    {
        printf("Value not found!\n");
        return start;
    }

    if (ptr->prev != NULL)
        ptr->prev->next = ptr->next;
    else
        start = ptr->next;

    if (ptr->next != NULL)
        ptr->next->prev = ptr->prev;

    free(ptr);
    return start;
}


void display(struct node *start)
{
    struct node *ptr = start;

    if (start == NULL)
    {
        printf("\nList is empty!\n");
        return;
    }

    printf("\nDoubly Linked List: ");
    while (ptr != NULL)
    {
        printf("%d <-> ", ptr->data);
        ptr = ptr->next;
    }
    printf("NULL\n");
}


int main()
{
    int choice;

    while (1)
    {
        printf("\n\n******** MENU ********");
        printf("\n1. Create Doubly Linked List");
        printf("\n2. Insert Before a Value");
        printf("\n3. Delete a Value");
        printf("\n4. Display");
        printf("\n5. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
        case 1:
            start = create_ll(start);
            break;

        case 2:
            start = insert_before(start);
            break;

        case 3:
            start = delete_value(start);
            break;

        case 4:
            display(start);
            break;

        case 5:
            exit(0);

        default:
            printf("Invalid Choice!");
        }
    }

    return 0;
}
